  "transcripts": [
    {
      "schemaVersion": 1,
      "id": "transcript-1",
      "mediaVersionID": "media-1",
      "locale": "de-DE",
      "timingStatus": "verified",
      "origin": "userImport",
      "segments": [
        {
          "id": "seg-1-0",
          "text": "Ein lokales Modell kann Anfragen ohne externen Modellanbieter verarbeiten.",
          "range": {
            "startMs": 10000,
            "endMs": 26000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        },
        {
          "id": "seg-1-1",
          "text": "Der Betriebsaufwand bleibt eine eigene Aufgabe.",
          "range": {
            "startMs": 30000,
            "endMs": 46000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        },
        {
          "id": "seg-1-2",
          "text": "Diese Einschätzung ist kein allgemeines Kostenversprechen.",
          "range": {
            "startMs": 50000,
            "endMs": 66000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "transcript-2",
      "mediaVersionID": "media-2",
      "locale": "de-DE",
      "timingStatus": "verified",
      "origin": "userImport",
      "segments": [
        {
          "id": "seg-2-0",
          "text": "Ein verwalteter Cloud-Dienst kann den eigenen Betriebsaufwand fuer ein Modell verringern.",
          "range": {
            "startMs": 10000,
            "endMs": 26000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        },
        {
          "id": "seg-2-1",
          "text": "Dafuer werden Netzanbindung und die Freigabe der Datenverarbeitung beim Dienst benoetigt.",
          "range": {
            "startMs": 30000,
            "endMs": 46000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        },
        {
          "id": "seg-2-2",
          "text": "Dieser Vorteil gilt nicht fuer jeden Offline- oder Datenschutzbedarf.",
          "range": {
            "startMs": 50000,
            "endMs": 66000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "transcript-3",
      "mediaVersionID": "media-3",
      "locale": "de-DE",
      "timingStatus": "verified",
      "origin": "userImport",
      "segments": [
        {
          "id": "seg-3-0",
          "text": "Fuer Arbeiten ohne Netz braucht eine Anwendung einen verlaesslichen lokalen Pfad.",
          "range": {
            "startMs": 10000,
            "endMs": 26000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        },
        {
          "id": "seg-3-1",
          "text": "Eine Cloudfunktion kann spaeter zusaetzliche Faehigkeiten bereitstellen.",
          "range": {
            "startMs": 30000,
            "endMs": 46000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        },
        {
          "id": "seg-3-2",
          "text": "Die Architekturentscheidung haengt von der konkreten Ausfallsituation ab.",
          "range": {
            "startMs": 50000,
            "endMs": 66000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "transcript-4",
      "mediaVersionID": "media-4",
      "locale": "de-DE",
      "timingStatus": "verified",
      "origin": "userImport",
      "segments": [
        {
          "id": "seg-4-0",
          "text": "Eine hybride Architektur kann lokale Grundfunktionen und verwaltete Zusatzfunktionen trennen.",
          "range": {
            "startMs": 10000,
            "endMs": 26000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        },
        {
          "id": "seg-4-1",
          "text": "Die Schnittstellen und die Zustandsuebernahme brauchen dann eigene Tests.",
          "range": {
            "startMs": 30000,
            "endMs": 46000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        },
        {
          "id": "seg-4-2",
          "text": "Mehr Komponenten sind nicht automatisch eine bessere Loesung.",
          "range": {
            "startMs": 50000,
            "endMs": 66000
          },
          "final": true,
          "speakerLabel": "Sprecher A (synthetisch)"
        }
      ]
    }
  ],
