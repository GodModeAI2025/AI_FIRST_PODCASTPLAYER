        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcript can't be created for this episode."
          }
        }
      }
    },
    "Für diese Folge lässt sich kein Transkript erstellen. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
