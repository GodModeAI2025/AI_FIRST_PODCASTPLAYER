            "state": "translated",
            "value": "The podcast doesn't provide chapter markers for this episode."
          }
        }
      }
    },
    "Der Server des Podcasts antwortet gerade nicht (Status %lld). Später noch einmal versuchen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server des Podcasts antwortet gerade nicht (Status %lld). Später noch einmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The podcast's server isn't responding right now (status %lld). Try again later."
          }
        }
      }
    },
    "Der Server des Podcasts hat die Anfrage abgelehnt (Status %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server des Podcasts hat die Anfrage abgelehnt (Status %lld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The podcast's server rejected the request (status %lld)."
          }
