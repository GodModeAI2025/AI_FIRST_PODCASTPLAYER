            "value": "The episode couldn't be loaded: %@"
          }
        }
      }
    },
    "Die Folge lässt sich nicht abspielen. Der Server liefert kein abspielbares Audio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Folge lässt sich nicht abspielen. Der Server liefert kein abspielbares Audio."
