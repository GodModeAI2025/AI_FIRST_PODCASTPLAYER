    },
    "%@ Deshalb habe ich keine Belege, mit denen ich antworten kann." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Deshalb habe ich keine Belege, mit denen ich antworten kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ So I don't have any source passages to answer with."
          }
        }
      }
    },
    "%@ In den Einstellungen ist Mobilfunk dafür aus. Bis du wieder im WLAN bist, fragt die App nach einem Ja nicht noch einmal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ In den Einstellungen ist Mobilfunk dafür aus. Bis du wieder im WLAN bist, fragt die App nach einem Ja nicht noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cellular data is turned off for this in Settings. Once you allow it, the app won't ask again until you're back on Wi-Fi."
          }
        }
      }
    },
    "%@ abbestellen" : {
      "localizations" : {
