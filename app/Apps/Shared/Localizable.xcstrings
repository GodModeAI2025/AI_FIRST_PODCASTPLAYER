    "Folge und alle Daten löschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Episode and All Data"
          }
        }
      }
    },
    "Folge öffnen und abspielen. Die App merkt sich die Stelle, auch über iPhone, iPad und Mac hinweg. Im Player: Tempo, Kapitel, Schlaf-Timer, AirPlay.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an episode and play it. The app remembers where you left off, even across iPhone, iPad, and Mac. In the player: speed, chapters, Sleep Timer, AirPlay."
          }
        }
      }
    },
    "Folgen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Episodes"
          }
        }
      }
    },
    "Folgen je Podcast": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Episodes per Podcast"
          }
        }
      }
    },
    "Folgen mit Shownotes, Kapiteln, Fakten und Transkript, Chat-Antworten mit Belegen und gemerkte Stellen als Markdown, etwa für Obsidian oder Notion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export episodes with show notes, chapters, facts, and transcript, plus chat answers with source passages and saved moments, as Markdown for apps like Obsidian or Notion."
          }
        }
      }
    },
    "Formuliere, was du für richtig hältst. PodcastAI sucht dazu belegte Positionen aus deinen Podcasts, dafür und dagegen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State what you believe is true. PodcastAI finds positions for and against it in your podcasts, each backed by source passages."
          }
        }
      }
    },
    "Fortgeschrittene: verstehen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced: Understanding"
          }
        }
      }
    },
    "Fortschritt der Stelle": {
