        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Oder zum Ausprobieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or Try One of These"
          }
        }
      }
