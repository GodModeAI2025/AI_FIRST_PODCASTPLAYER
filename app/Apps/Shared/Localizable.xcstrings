        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determines which passages are shown to you as relevant. You can view and correct it at any time."
          }
        }
      }
    },
    "Bisher aus den Shownotes. Mit dem Transkript kommt mehr dazu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
