    },
    "Die Stellen sind gerade nicht abspielbar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stellen sind gerade nicht abspielbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These passages can't be played right now."
          }
