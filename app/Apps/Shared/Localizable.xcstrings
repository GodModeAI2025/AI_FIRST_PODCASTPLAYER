    },
    "%@ bietet keinen Feed an. Manche Seiten verlinken ihn nur auf einer Unterseite. Dann hilft die Adresse des Feeds selbst." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bietet keinen Feed an. Manche Seiten verlinken ihn nur auf einer Unterseite. Dann hilft die Adresse des Feeds selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ doesn't offer a feed. Some sites only link to it on a subpage. In that case, use the feed URL itself."
