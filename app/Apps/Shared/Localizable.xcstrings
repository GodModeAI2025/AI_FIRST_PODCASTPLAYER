    "Aus deinen Interessen baut PodcastAI einen eigenen Podcast. Er besteht aus Originalstellen, die du noch nicht gehört hast.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deinen Interessen baut PodcastAI einen eigenen Podcast. Er besteht aus Originalstellen, die du noch nicht gehört hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PodcastAI builds a podcast of your own from your interests. It's made of original passages you haven't heard yet."
          }
        }
      }
    },
    "Aus dem Wortschatz des Systems, auf diesem Gerät berechnet. Nur übernehmen, was passt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Wortschatz des Systems, auf diesem Gerät berechnet. Nur übernehmen, was passt."
