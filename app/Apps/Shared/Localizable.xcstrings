            "value" : "Bonus"
          }
        }
      }
    },
    "Charts und Verzeichnis: [Apple Podcasts](https://podcasts.apple.com). Die Suche fragt zusätzlich [Podcast Index](https://podcastindex.org)." : {
      "localizations" : {
        "de" : {
