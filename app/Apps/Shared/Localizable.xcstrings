    "Pausieren hält Transkripte, Fakten und Tags an, auch nach einem Neustart. Die laufende Folge behält, was sie schon erkannt hat, und macht dort weiter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausieren hält Transkripte, Fakten und Tags an, auch nach einem Neustart. Die laufende Folge behält, was sie schon erkannt hat, und macht dort weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
