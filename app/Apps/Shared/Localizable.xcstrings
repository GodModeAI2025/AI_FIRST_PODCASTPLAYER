        }
      }
    },
    "Sobald das Transkript fertig ist, zieht die App überprüfbare Aussagen mit Zeitmarke heraus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald das Transkript fertig ist, zieht die App überprüfbare Aussagen mit Zeitmarke heraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the transcript is ready, the app pulls out verifiable statements with timestamps."
          }
        }
      }
    },
    "Sobald genug ungehörtes Material zu deinen Themen vorliegt, entsteht daraus von selbst eine Ausgabe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald genug ungehörtes Material zu deinen Themen vorliegt, entsteht daraus von selbst eine Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once there's enough unheard material on your topics, a new edition is created automatically."
          }
        }
      }
    },
    "Solange der Datensparmodus an ist, wartet die App damit.": {
      "localizations": {
