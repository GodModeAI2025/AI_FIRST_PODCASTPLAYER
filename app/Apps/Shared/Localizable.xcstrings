            "value": "The server can't be reached."
          }
        }
      }
    },
    "Der Speicher konnte nicht geöffnet werden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher konnte nicht geöffnet werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage Couldn't Be Opened"
          }
        }
      }
    },
    "Der Speicher lässt sich immer noch nicht öffnen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher lässt sich immer noch nicht öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage Still Can't Be Opened"
          }
        }
      }
    },
    "Der Speicher wurde neu angelegt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher wurde neu angelegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage Was Recreated"
          }
        }
      }
    },
    "Der mitgeschriebene Text einer Folge. Erst damit kannst du in der Folge suchen und Fragen stellen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der mitgeschriebene Text einer Folge. Erst damit kannst du in der Folge suchen und Fragen stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcribed text of an episode. Only with it can you search the episode and ask questions about it."
          }
        }
      }
    },
    "Der übersprungene Teil zählt nicht als gehört": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der übersprungene Teil zählt nicht als gehört"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The skipped part doesn't count as heard"
          }
        }
      }
    },
    "Deutsch · KI in Wissenschaft und Praxis": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutsch · KI in Wissenschaft und Praxis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "German · AI in science and practice"
          }
        }
      }
    },
    "Die App erstellt das Transkript auf dem Gerät, mit Zeitmarken.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erstellt das Transkript auf dem Gerät, mit Zeitmarken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app creates the transcript on the device, with timestamps."
          }
        }
      }
    },
    "Die App erstellt ein Transkript nach dem anderen. Auf dem iPhone geht die Arbeit im Hintergrund weiter, solange die Fortschrittsanzeige des Systems zu sehen ist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erstellt ein Transkript nach dem anderen. Auf dem iPhone geht die Arbeit im Hintergrund weiter, solange die Fortschrittsanzeige des Systems zu sehen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app creates one transcript at a time. On iPhone, the work continues in the background as long as the system progress indicator is visible."
          }
        }
      }
    },
    "Die App läuft weiter ohne Speicher, und was du jetzt anlegst, ist beim nächsten Start weg.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App läuft weiter ohne Speicher, und was du jetzt anlegst, ist beim nächsten Start weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app keeps running without storage, and anything you create now will be gone the next time it starts."
          }
        }
      }
    },
    "Die App schreibt Folgen auf dem Gerät mit Zeitmarken mit. Im Reiter „Transkript“ springt ein Tipp an die Stelle; die Suche findet jedes Wort. Für ältere Folgen tippst du in der Folge auf „Transkript erstellen“.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App schreibt Folgen auf dem Gerät mit Zeitmarken mit. Im Reiter „Transkript“ springt ein Tipp an die Stelle; die Suche findet jedes Wort. Für ältere Folgen tippst du in der Folge auf „Transkript erstellen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app transcribes episodes on your device, with timestamps. In the \"Transcript\" tab, tap any passage to jump to it; search finds every word. For older episodes, tap \"Create Transcript\" in the episode."
          }
        }
      }
    },
    "Die Audiodatei dieser Folge lässt sich nicht lesen. Das liegt meist an der Datei selbst, nicht an der App.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodatei dieser Folge lässt sich nicht lesen. Das liegt meist an der Datei selbst, nicht an der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio file for this episode can't be read. This is usually a problem with the file itself, not the app."
          }
        }
      }
    },
    "Die Ausgabe konnte nicht erstellt werden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe konnte nicht erstellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edition couldn't be created."
          }
        }
      }
    },
    "Die Ausgabe wird gerade zusammengestellt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe wird gerade zusammengestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An edition is already being put together."
          }
        }
      }
    },
    "Die Ausgabe wird zusammengestellt …": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe wird zusammengestellt …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the edition together…"
          }
        }
      }
    },
    "Die Datei ist größer, als die App lädt. Für sehr lange Folgen lässt sich im Moment kein Transkript erstellen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist größer, als die App lädt. Für sehr lange Folgen lässt sich im Moment kein Transkript erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is larger than the app can load. Transcripts can't be created for very long episodes at the moment."
          }
        }
      }
    },
    "Die Datenbank liess sich nicht öffnen. Die App läuft ohne Speicher, und was du jetzt anlegst, ist beim nächsten Start weg.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank liess sich nicht öffnen. Die App läuft ohne Speicher, und was du jetzt anlegst, ist beim nächsten Start weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database couldn't be opened. The app is running without storage, and anything you create now will be gone the next time it starts."
          }
        }
      }
    },
    "Die Datenbank von PodcastAI liess sich nicht öffnen. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank von PodcastAI liess sich nicht öffnen. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PodcastAI database couldn't be opened. %@"
          }
        }
      }
    },
    "Die Fakten konnten nicht ermittelt werden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fakten konnten nicht ermittelt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The facts couldn't be extracted."
          }
        }
      }
    },
    "Die Fakten konnten nicht ermittelt werden. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fakten konnten nicht ermittelt werden. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The facts couldn't be extracted. %@"
          }
        }
      }
    },
    "Die Fakten sind unvollständig: %lld von %lld Abschnitten der Folge fehlen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Die Fakten sind unvollständig: %1$lld von %2$lld Abschnitten der Folge fehlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The facts are incomplete: %1$lld of %2$lld sections of the episode are missing."
          }
        }
      }
    },
    "Die Folge ließ sich nicht laden: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Folge ließ sich nicht laden: %@"
          }
        },
