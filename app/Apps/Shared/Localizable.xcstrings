    "„%@“ ist nicht auf diesem Gerät geladen. Ohne Netz lässt sich die Folge nicht abspielen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist nicht auf diesem Gerät geladen. Ohne Netz lässt sich die Folge nicht abspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" isn't downloaded to this device. Without a connection, the episode can't be played."
          }
        }
      }
    },
    "„%@“ liegt nicht auf diesem Gerät. Zum Abspielen kommt der Ton über Mobilfunk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
