            "value": "Step 2 of 3: Creating transcript"
          }
        }
      }
    },
    "Schritt 3 von 3: Fundstellen werden gebildet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 3 of 3: Indexing passages"
          }
        }
      }
    },
    "Seit der letzten Ausgabe ist nichts dazugekommen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing new since the last edition."
