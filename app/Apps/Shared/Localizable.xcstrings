        }
      }
    },
    "Merkt sich die Stelle, die gerade läuft, mit Folge, Podcast und Zeitmarke. Gibt es ein Transkript, kommt der Originaltext dazu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkt sich die Stelle, die gerade läuft, mit Folge, Podcast und Zeitmarke. Gibt es ein Transkript, kommt der Originaltext dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves the passage that's playing, with episode, podcast, and timestamp. If there's a transcript, the original text is included."
          }
        }
      }
    },
    "Mit Quelle kopieren" : {
      "localizations" : {
        "de" : {
