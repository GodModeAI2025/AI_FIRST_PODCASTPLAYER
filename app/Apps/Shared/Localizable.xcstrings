            "state": "translated",
            "value": "Save Passage"
          }
        }
      }
    },
    "Stellen werden gesucht und eingeordnet …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding and classifying passages…"
          }
        }
      }
    },
    "Stellen zur These": {},
    "Stellt aus deinen ungehörten Originalstellen eine neue Ausgabe zusammen. Startet keine Wiedergabe.": {
      "localizations": {
        "en": {
          "stringUnit": {
