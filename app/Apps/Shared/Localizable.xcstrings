    },
    "Die nächste Ausgabe kommt, sobald %@ neues Material da ist. Zurzeit sind es %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Die nächste Ausgabe kommt, sobald %1$@ neues Material da ist. Zurzeit sind es %2$@."
