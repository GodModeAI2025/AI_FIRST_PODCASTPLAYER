    "Bei %lld davon ging aus einem anderen Grund etwas schief. Ein neuer Versuch kann sie nachholen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %lld davon ging aus einem anderen Grund etwas schief. Ein neuer Versuch kann sie nachholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of them failed for another reason. Trying again can fill them in."
          }
        }
      }
    },
    "Bei %lld davon ging aus einem anderen Grund etwas schief. „Neu ermitteln“ versucht es dort noch einmal.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %lld davon ging aus einem anderen Grund etwas schief. „Neu ermitteln“ versucht es dort noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %lld of them, something else went wrong. \"Extract Again\" tries those once more."
          }
        }
      }
    },
    "Beim Erstellen des Transkripts ist etwas schiefgegangen (%@). Noch einmal versuchen, bei Wiederholung bitte als Feedback melden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erstellen des Transkripts ist etwas schiefgegangen (%@). Noch einmal versuchen, bei Wiederholung bitte als Feedback melden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong while creating the transcript (%@). Try again, and if it keeps happening, please send feedback."
          }
        }
      }
    },
