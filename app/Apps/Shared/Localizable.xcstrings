    },
    "Eine Fundstelle mit Quelle und Zeitmarke abrufen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Fundstelle mit Quelle und Zeitmarke abrufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a passage with its source and timestamp"
          }
