      }
    },
    "Der Server hat nichts geliefert. Später noch einmal versuchen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nichts geliefert. Später noch einmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't return anything. Try again later."
          }
        }
      }
    },
    "Der Server ist nicht erreichbar.": {
      "localizations": {
