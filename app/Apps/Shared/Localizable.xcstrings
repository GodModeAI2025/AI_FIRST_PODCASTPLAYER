          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text a podcast includes with an episode, often with links. You'll find it in the episode under \"Overview\"."
          }
        }
      }
    },
    "Der Ton liegt schon auf dem Gerät. Das Sprachmodell für die Sprache dieser Folge lädt die App noch aus dem Netz." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
