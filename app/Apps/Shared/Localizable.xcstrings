            "value" : "One Podcast"
          }
        }
      }
    },
    "Ein Thema findet Stellen, in denen seine Bezeichnung oder eines seiner Stichworte vorkommt, und nur in Folgen mit Transkript." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Thema findet Stellen, in denen seine Bezeichnung oder eines seiner Stichworte vorkommt, und nur in Folgen mit Transkript."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A topic finds passages where its name or one of its keywords appears, and only in episodes with a transcript."
          }
        }
      }
    },
    "Ein Tipp auf ein Thema mit Plus legt es als Interesse an." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tipp auf ein Thema mit Plus legt es als Interesse an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a topic with a plus to add it as an interest."
          }
        }
      }
    },
    "Ein Transkript erstellst du in der Folge mit „Transkript erstellen“. Für neue Folgen geht das von selbst, wenn in den Einstellungen „Transkripte für neue Folgen erstellen“ an ist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Transkript erstellst du in der Folge mit „Transkript erstellen“. Für neue Folgen geht das von selbst, wenn in den Einstellungen „Transkripte für neue Folgen erstellen“ an ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get one, open the episode and tap \"Create Transcript\". New episodes get one automatically when \"Create transcripts for new episodes\" is on in Settings."
          }
        }
      }
    },
    "Ein Zugang ohne Protokoll ist kein kontrollierter Zugang." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Zugang ohne Protokoll ist kein kontrollierter Zugang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access without a log isn't controlled access."
          }
        }
      }
    },
    "Eine Antwort aus dem Chat, die du mit ihren Stellen aufbewahrst. Du findest sie unter „Wissen“." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Antwort aus dem Chat, die du mit ihren Stellen aufbewahrst. Du findest sie unter „Wissen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An answer from Chat that you keep along with its passages. You can find saved answers under \"Knowledge\"."
          }
        }
      }
    },
    "Eine Antwort formulieren kann ich gerade nicht. %@\n\nDiese Stellen passen am besten:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Antwort formulieren kann ich gerade nicht. %@\n\nDiese Stellen passen am besten:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can't write an answer right now. %@\n\nThese passages match best:"
          }
        }
      }
    },
    "Eine Folge" : {
      "localizations" : {
