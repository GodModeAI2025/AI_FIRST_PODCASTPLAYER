    "Fakten zieht die App nach jedem Transkript mit Apple Intelligence auf dem Gerät heraus, auch im Hintergrund und für ältere Folgen mit Transkript. Dafür braucht es kein Netz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fakten zieht die App nach jedem Transkript mit Apple Intelligence auf dem Gerät heraus, auch im Hintergrund und für ältere Folgen mit Transkript. Dafür braucht es kein Netz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After each transcript, the app extracts facts with Apple Intelligence on device, also in the background and for older episodes with a transcript. No network is needed."
          }
        }
      }
    },
    "Fakten: ^[%lld Folge](inflect: true)": {
      "localizations": {
        "de": {
          "stringUnit": {
