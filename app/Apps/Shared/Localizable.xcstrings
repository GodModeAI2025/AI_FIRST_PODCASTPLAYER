          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The audio is already on the device. The app still needs to download the speech model for this episode's language."
          }
        }
      }
    },
    "Der mitgeschriebene Text einer Folge. Erst damit kannst du in der Folge suchen und Fragen stellen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der mitgeschriebene Text einer Folge. Erst damit kannst du in der Folge suchen und Fragen stellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transcribed text of an episode. Only with it can you search the episode and ask questions about it."
          }
        }
      }
    },
    "Der neue Lauf fand keine überprüfbaren Aussagen. Die bisherigen Fakten bleiben." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der neue Lauf fand keine überprüfbaren Aussagen. Die bisherigen Fakten bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new run found no verifiable statements. The previous facts are kept."
          }
        }
      }
    },
    "Der neue Lauf fand nur %@ statt %lld. Die bisherigen Fakten bleiben." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Der neue Lauf fand nur %1$@ statt %2$lld. Die bisherigen Fakten bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new run found only %1$@ instead of %2$lld. The previous facts are kept."
          }
        }
      }
    },
    "Der übersprungene Teil zählt nicht als gehört" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der übersprungene Teil zählt nicht als gehört"
