    },
    "Mit Quelle kopiert." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Quelle kopiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied with source."
          }
        }
      }
    },
    "Mit „Auf dem Gerät behalten“ im Menü bleibt es." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Auf dem Gerät behalten“ im Menü bleibt es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose \"Keep on Device\" in the menu to keep it."
          }
        }
      }
    },
    "Mit „Neueste Folge je Podcast behalten“ bleibt die neueste Folge jedes Podcasts auf dem Gerät und spielt ohne Netz, bis eine neuere geladen ist. Mit „Audio entfernen, wenn das Transkript fertig ist“ nimmt die App die anderen Folgen nach dem Transkript wieder vom Gerät, abgespielt wird dann aus dem Netz. Was du mit „Laden (offline)“ holst, bleibt, bis du „Audio entfernen“ wählst. „Audio entfernen“ löscht nur den Ton; Transkripte, Fakten, gemerkte Stellen und der Hörstand bleiben. Eine einzelne Folge löschst du in der Folge selbst, dann verschwinden auch ihre Daten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Neueste Folge je Podcast behalten“ bleibt die neueste Folge jedes Podcasts auf dem Gerät und spielt ohne Netz, bis eine neuere geladen ist. Mit „Audio entfernen, wenn das Transkript fertig ist“ nimmt die App die anderen Folgen nach dem Transkript wieder vom Gerät, abgespielt wird dann aus dem Netz. Was du mit „Laden (offline)“ holst, bleibt, bis du „Audio entfernen“ wählst. „Audio entfernen“ löscht nur den Ton; Transkripte, Fakten, gemerkte Stellen und der Hörstand bleiben. Eine einzelne Folge löschst du in der Folge selbst, dann verschwinden auch ihre Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With \"Keep Newest Episode of Each Podcast\" on, the newest episode of each podcast stays on the device and plays without a connection until a newer one is downloaded. With \"Remove Audio When Transcript Is Ready\" on, the app removes the other episodes from the device after their transcript, and they play from the internet. Anything you get with \"Download\" stays until you choose \"Remove Audio\". \"Remove Audio\" deletes only the audio; transcripts, facts, saved moments, and your listening progress stay. To delete a single episode, do it in the episode itself. Its data goes with it."
          }
        }
      }
    },
    "Mobilfunk" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilfunk"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellular Data"
          }
