    },
    "Der Schlüssel ließ sich im Schlüsselbund nicht sichern." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel ließ sich im Schlüsselbund nicht sichern."
          }
