    "Bestimmt, welche Stellen dir als relevant angezeigt werden. Jederzeit einsehbar und korrigierbar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmt, welche Stellen dir als relevant angezeigt werden. Jederzeit einsehbar und korrigierbar."
          }
