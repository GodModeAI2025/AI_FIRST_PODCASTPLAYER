        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the system vocabulary, computed on this device. Only add what fits."
          }
        }
      }
    },
    "Aus dieser Folge liessen sich keine Fakten ermitteln: %lld von %lld Abschnitten fehlen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Aus dieser Folge liessen sich keine Fakten ermitteln: %1$lld von %2$lld Abschnitten fehlen."
