        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You create the next edition yourself."
          }
        }
      }
    },
    "Die nächste Ausgabe kommt frühestens %@ oder sobald du alle ihre Teile gehört hast, wenn dann mindestens %@ neues Material da ist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Ausgabe kommt frühestens %1$@ oder sobald du alle ihre Teile gehört hast, wenn dann mindestens %2$@ neues Material da ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next edition comes %1$@ at the earliest, or once you've listened to all parts of this one, as long as there's at least %2$@ of new material by then."
          }
        }
      }
    },
    "Die nächste Ausgabe kommt, sobald %@ neues Material da ist." : {
      "localizations" : {
