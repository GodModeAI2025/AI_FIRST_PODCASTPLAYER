    "Podcast-Daten: Charts und Kategorien kommen von Apple Podcasts, gesucht wird bei Apple und bei Podcast Index (podcastindex.org). Beide sehen deinen Suchbegriff und deine IP-Adresse, ein Konto gibt es bei keinem." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podcast-Daten: Charts und Kategorien kommen von Apple Podcasts, gesucht wird bei Apple und bei Podcast Index (podcastindex.org). Beide sehen deinen Suchbegriff und deine IP-Adresse, ein Konto gibt es bei keinem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podcast data: charts and categories come from Apple Podcasts, and search uses Apple and Podcast Index (podcastindex.org). Both see your search term and your IP address. Neither requires an account."
          }
        }
      }
    },
    "Podcast-Katalog" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podcast-Katalog"
          }
        },
        "en" : {
