    "Jede Antwort nennt die Stellen, aus denen sie stammt. Ein Tipp auf einen Beleg spielt die Stelle im Original." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Antwort nennt die Stellen, aus denen sie stammt. Ein Tipp auf einen Beleg spielt die Stelle im Original."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every answer names the passages it comes from. Tap a source passage to play it in the original."
          }
        }
      }
    },
    "Jede Folge dieser Quelle hat ein Transkript. Ohne den Filter siehst du alle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Folge dieser Quelle hat ein Transkript. Ohne den Filter siehst du alle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every episode from this source has a transcript. Turn off the filter to see all of them."
          }
        }
      }
    },
    "Jede Folge und jedes Kapitel trägt Tags aus dem Inhalt. Plus heißt folgen, Minus heißt nicht mehr folgen. Gefolgte Tags füllen „Für dich“ und die Themen-Updates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Folge und jedes Kapitel trägt Tags aus dem Inhalt. Plus heißt folgen, Minus heißt nicht mehr folgen. Gefolgte Tags füllen „Für dich“ und die Themen-Updates."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every episode and every chapter carries tags from its content. Plus means follow, minus means stop following. Followed tags fill “For You” and the Topic Updates."
          }
        }
      }
    },
