    "Abos, Transkripte, Fakten, Hörstand, Interessen, Themen-Updates und gemerkte Stellen gleichen sich über deine private iCloud-Datenbank zwischen iPhone, iPad und Mac ab. Audiodateien lädt jedes Gerät selbst." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos, Transkripte, Fakten, Hörstand, Interessen, Themen-Updates und gemerkte Stellen gleichen sich über deine private iCloud-Datenbank zwischen iPhone, iPad und Mac ab. Audiodateien lädt jedes Gerät selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions, transcripts, facts, listening progress, interests, Topic Updates, and saved moments sync between iPhone, iPad, and Mac through your private iCloud database. Each device downloads audio files on its own."
          }
        }
      }
    },
    "Abos, Transkripte, Fakten, Notizen, Interessen und Hörstand liegen in deiner privaten iCloud-Datenbank. Nur deine Geräte mit derselben Apple-ID lesen sie." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos, Transkripte, Fakten, Notizen, Interessen und Hörstand liegen in deiner privaten iCloud-Datenbank. Nur deine Geräte mit derselben Apple-ID lesen sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions, transcripts, facts, notes, interests, and listening progress are stored in your private iCloud database. Only your devices signed in with the same Apple Account can read them."
          }
        }
      }
    },
