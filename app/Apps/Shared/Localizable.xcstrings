            "state": "translated",
            "value": "Facts"
          }
        }
      }
    },
    "Fakten ermitteln": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extract Facts"
          }
        }
      }
