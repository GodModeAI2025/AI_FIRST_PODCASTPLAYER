<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Erweiterungen auf dem Mac laufen immer in der Sandbox. Ins Netz geht
         diese nicht; geteilte Dateien liest sie über die Freigabe selbst. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Übergabe an die App: Eingang im gemeinsamen Ordner, derselbe wie für das Widget. -->
    <key>com.apple.security.application-groups</key>
    <array><string>group.com.godmodeai.podcastai</string></array>
</dict>
</plist>
