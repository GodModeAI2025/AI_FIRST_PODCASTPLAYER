<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Wie PodcastAI.entitlements, dazu CarPlay Audio. Wird nur mit der
        Build-Einstellung PODCASTAI_VARIANT: CarPlay benutzt (siehe
        docs/plan-player-plattformen.md). Das Entitlement darf erst
        signiert werden, wenn Apple es für die App freigegeben hat; ohne
        Freigabe scheitert die Signierung. Ein Test hält diese Datei und
        PodcastAI.entitlements im Gleichschritt.
    -->
    <key>com.apple.developer.carplay-audio</key>
    <true/>
    <!-- Abgleich über die private iCloud-Datenbank, derselbe Container wie auf dem Mac. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array><string>iCloud.com.godmodeai.podcastai</string></array>
    <key>com.apple.developer.icloud-services</key>
    <array><string>CloudKit</string></array>
    <key>aps-environment</key><string>development</string>
    <!-- Gemeinsamer Ordner mit „An PodcastAI senden“ und dem Widget. -->
    <key>com.apple.security.application-groups</key>
    <array><string>group.com.godmodeai.podcastai</string></array>
    <!-- Apple Intelligence auf Private Cloud Compute, von Apple für das Team freigegeben. -->
    <key>com.apple.developer.private-cloud-compute</key>
    <true/>
</dict>
</plist>
