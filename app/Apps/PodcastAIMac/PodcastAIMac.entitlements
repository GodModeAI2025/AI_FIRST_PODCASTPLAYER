<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.network.client</key><true/>
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <!-- Abgleich über die private iCloud-Datenbank, derselbe Container wie auf iPhone und iPad. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array><string>iCloud.com.godmodeai.podcastai</string></array>
    <key>com.apple.developer.icloud-services</key>
    <array><string>CloudKit</string></array>
    <key>com.apple.developer.aps-environment</key><string>development</string>
    <!-- Apple Intelligence auf Private Cloud Compute, von Apple für das Team freigegeben. -->
    <key>com.apple.developer.private-cloud-compute</key>
    <true/>
    <!-- Gemeinsamer Ordner mit dem Widget: die App schreibt dort, was es zeigt. -->
    <key>com.apple.security.application-groups</key>
    <array><string>group.com.godmodeai.podcastai</string></array>
</dict>
</plist>
