<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Widgets auf dem Mac laufen in der Sandbox, ohne Netz und ohne Dateizugriff. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Liest den Schnappschuss, den die App in den gemeinsamen Ordner schreibt. -->
    <key>com.apple.security.application-groups</key>
    <array><string>group.com.godmodeai.podcastai</string></array>
</dict>
</plist>
