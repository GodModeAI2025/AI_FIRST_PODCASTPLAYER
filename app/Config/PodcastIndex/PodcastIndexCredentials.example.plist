<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vorlage für den Zugang zum Podcast-Katalog (api.podcastindex.org).

  Kopieren nach PodcastIndexCredentials.plist im selben Ordner und dort
  Schlüssel und Geheimnis eintragen. Die Kopie steht in .gitignore und kommt
  nie ins Repository. Fehlt sie oder ist ein Feld leer, sucht die App nur
  im Apple-Podcast-Verzeichnis und zeigt keine Trends und Rubriken.
-->
<plist version="1.0">
<dict>
	<key>APIKey</key>
	<string></string>
	<key>APISecret</key>
	<string></string>
</dict>
</plist>
