{
  "sourceLanguage" : "de",
  "strings" : {
    "Auf diesem Gerät gibt es keine Spracherkennung. Im Simulator ist das normal. Auf einem iPhone, iPad oder Mac mit aktueller Software funktioniert es." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition isn't available on this device. That's expected in Simulator. It works on an iPhone, iPad, or Mac with current software."
          }
        }
      }
    },
    "Das Sprachmodell ist nicht bereit: %@" : {
      "localizations" : {
