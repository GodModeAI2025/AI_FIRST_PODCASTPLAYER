{
  "sourceLanguage": "de",
  "strings": {
    "Auf diesem Gerät gibt es keine Spracherkennung. Im Simulator ist das normal. Auf einem iPhone, iPad oder Mac mit aktueller Software funktioniert es.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gibt es keine Spracherkennung. Im Simulator ist das normal. Auf einem iPhone, iPad oder Mac mit aktueller Software funktioniert es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition isn't available on this device. That's expected in Simulator. It works on an iPhone, iPad, or Mac with current software."
          }
        }
      }
    },
    "Das Sprachmodell ist nicht bereit: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell ist nicht bereit: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech model isn't ready: %@"
          }
        }
      }
    },
    "Die Datei konnte nicht gelesen werden: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gelesen werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file couldn't be read: %@"
          }
        }
      }
    },
    "Es wird bereits ein Transkript erstellt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird bereits ein Transkript erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcript is already being created."
          }
        }
      }
    },
    "Für %@ ist kein Sprachmodell verfügbar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ ist kein Sprachmodell verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speech model is available for %@."
          }
        }
      }
    },
    "Kein kompatibles Audioformat gefunden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein kompatibles Audioformat gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No compatible audio format found."
          }
        }
      }
    }
  },
  "version": "1.0"
}
