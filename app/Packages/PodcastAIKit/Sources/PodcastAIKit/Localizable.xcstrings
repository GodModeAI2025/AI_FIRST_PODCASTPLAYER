    "Das Ergebnis ließ sich nicht darstellen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis ließ sich nicht darstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result could not be encoded."
          }
        }
      }
    },
    "Der Agentenzugang ist in PodcastAI ausgeschaltet. Einschalten lässt er sich in PodcastAI unter Einstellungen › Agenten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agentenzugang ist in PodcastAI ausgeschaltet. Einschalten lässt er sich in PodcastAI unter Einstellungen › Agenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent access is turned off in PodcastAI. You can turn it on in PodcastAI under Settings › Agents."
          }
        }
      }
    },
    "Die Anfrage ist zu lang.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage ist zu lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request is too long."
          }
        }
      }
    },
    "Die Freigabe in PodcastAI gilt nur für den Agenten „%@“, dieser meldet sich als „%@“. Unter Einstellungen › Agenten lässt sich die Freigabe für ihn erteilen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe in PodcastAI gilt nur für den Agenten „%@“, dieser meldet sich als „%@“. Unter Einstellungen › Agenten lässt sich die Freigabe für ihn erteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grant in PodcastAI only covers the agent “%1$@”, and this one identifies itself as “%2$@”. You can grant it access under Settings › Agents."
          }
        }
      }
    },
    "Die Freigabe in PodcastAI gilt nur für den Agenten „%@“. Dieser Agent hat keinen Namen gemeldet. Unter Einstellungen › Agenten lässt sich die Freigabe für jeden Agenten erteilen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe in PodcastAI gilt nur für den Agenten „%@“. Dieser Agent hat keinen Namen gemeldet. Unter Einstellungen › Agenten lässt sich die Freigabe für jeden Agenten erteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grant in PodcastAI only covers the agent “%@”. This agent did not report a name. Under Settings › Agents you can grant access to any agent."
          }
        }
      }
    },
    "Die Freigabe in PodcastAI ist am %@ um %@ abgelaufen. Erneuern lässt sie sich in PodcastAI unter Einstellungen › Agenten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe in PodcastAI ist am %@ um %@ abgelaufen. Erneuern lässt sie sich in PodcastAI unter Einstellungen › Agenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grant in PodcastAI expired on %1$@ at %2$@. You can renew it in PodcastAI under Settings › Agents."
          }
        }
      }
    },
    "Die Kennung einer Stelle, etwa aus searchEvidence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kennung einer Stelle, etwa aus searchEvidence."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ID of a passage, for example from searchEvidence."
          }
        }
      }
    },
    "Eine Fundstelle mit Quelle und Zeitmarke abrufen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Fundstelle mit Quelle und Zeitmarke abrufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch a passage with source and timestamp"
          }
        }
      }
    },
    "Eine kurze Frage oder Stichworte in der Sprache des Podcasts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Frage oder Stichworte in der Sprache des Podcasts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short question or keywords in the podcast's language."
          }
        }
      }
    },
    "Freigegebene Podcasts auflisten": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigegebene Podcasts auflisten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List shared podcasts"
          }
        }
      }
    },
    "Gefolgte Tags lesen": {
      "localizations": {
