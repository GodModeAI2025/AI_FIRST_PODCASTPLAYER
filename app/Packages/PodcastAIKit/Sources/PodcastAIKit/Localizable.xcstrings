    "Zu dieser podcastID gibt es im freigegebenen Bereich keine Folge mit Transkript. listPodcasts nennt die freigegebenen Podcasts mit ihrer Kennung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dieser podcastID gibt es im freigegebenen Bereich keine Folge mit Transkript. listPodcasts nennt die freigegebenen Podcasts mit ihrer Kennung."
          }
        },
        "en": {
