    "Supadata bittet um eine Pause. Die App versucht es später noch einmal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Supadata bittet um eine Pause. Die App versucht es später noch einmal."
