    "Supadata braucht für dieses Video länger. Die App fragt später noch einmal nach.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Supadata braucht für dieses Video länger. Die App fragt später noch einmal nach."
