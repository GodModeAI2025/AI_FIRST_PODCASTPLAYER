        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Supadata quota is used up."
          }
        }
      }
    },
    "Das ist keine gültige Adresse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn't a valid address."
          }
        }
      }
    },
    "Der Feed ist leer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Feed ist leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The feed is empty."
          }
        }
      }
    },
    "Der Feed ist zu groß (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Feed ist zu groß (%@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The feed is too large (%@)."
          }
        }
      }
    },
    "Der Feed konnte nicht gelesen werden: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Feed konnte nicht gelesen werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The feed couldn't be read: %@"
          }
        }
      }
    },
    "Der Podcast-Katalog antwortet gerade nicht (Status %@). Später noch einmal versuchen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Podcast-Katalog antwortet gerade nicht (Status %@). Später noch einmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The podcast catalog isn't responding right now (status %@). Try again later."
          }
        }
      }
    },
    "Der Podcast-Katalog bekommt gerade zu viele Anfragen. In einer Minute noch einmal versuchen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Podcast-Katalog bekommt gerade zu viele Anfragen. In einer Minute noch einmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The podcast catalog is getting too many requests right now. Try again in a minute."
          }
        }
      }
    },
    "Der Podcast-Katalog hat keine lesbare Antwort geschickt. Versuch es gleich noch einmal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Podcast-Katalog hat keine lesbare Antwort geschickt. Versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The podcast catalog sent an answer the app can't read. Try again in a moment."
          }
        }
      }
    },
    "Die Antwort von Supadata ließ sich nicht lesen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort von Supadata ließ sich nicht lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supadata's response could not be read."
          }
        }
      }
    },
    "Die Datei ist zu groß für eine Abo-Liste.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist zu groß für eine Abo-Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large for a subscription list."
          }
        }
      }
    },
    "Diese Datei ist keine OPML-Liste. Exportiere die Abos in deiner bisherigen App als OPML und wähle diese Datei.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist keine OPML-Liste. Exportiere die Abos in deiner bisherigen App als OPML und wähle diese Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file isn't an OPML list. Export your subscriptions as OPML from your previous app, then choose that file."
          }
        }
      }
    },
    "Dieses Format wird nicht unterstützt.": {
