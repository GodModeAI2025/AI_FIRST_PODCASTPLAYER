    "In dieser Datei stehen keine YouTube-Abos. Wähle aus dem Export von Google Takeout die CSV-Datei mit deinen Abos, etwa „subscriptions.csv“.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Datei stehen keine YouTube-Abos. Wähle aus dem Export von Google Takeout die CSV-Datei mit deinen Abos, etwa „subscriptions.csv“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file doesn't contain any YouTube subscriptions. From your Google Takeout export, choose the CSV file with your subscriptions, such as \"subscriptions.csv\"."
          }
        }
      }
    },
