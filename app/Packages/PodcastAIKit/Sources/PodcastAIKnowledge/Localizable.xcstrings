    "Unter den eingeordneten Stellen ist keine Gegenposition. Die übrigen sind nicht eingeordnet, darunter kann eine sein.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter den eingeordneten Stellen ist keine Gegenposition. Die übrigen sind nicht eingeordnet, darunter kann eine sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Among the classified passages there is no counterpoint. The rest aren't classified, and one of them could be."
          }
        }
      }
    },
