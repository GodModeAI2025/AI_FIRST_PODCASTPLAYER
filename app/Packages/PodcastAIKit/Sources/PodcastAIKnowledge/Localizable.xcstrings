    },
    "In deinen Folgen mit Transkript findet sich keine Gegenposition. Das heißt nicht, dass es keine gibt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinen Folgen mit Transkript findet sich keine Gegenposition. Das heißt nicht, dass es keine gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your transcribed episodes contain no counterpoint. That doesn't mean there isn't one."
          }
        }
      }
    },
    "In deinen Folgen mit Transkript findet sich nur die Gegenseite. Das ist keine ausgewogene Prüfung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinen Folgen mit Transkript findet sich nur die Gegenseite. Das ist keine ausgewogene Prüfung."
