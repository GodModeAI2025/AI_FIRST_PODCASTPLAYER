    },
    "Cover für %@: %@ aus %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Cover für %1$@: %2$@ aus %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover art for %1$@: %2$@ from %3$@."
          }
        }
      }
    },
    "Das Bild konnte nicht übernommen werden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte nicht übernommen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image couldn't be used."
          }
        }
      }
    },
    "Einzelne Abschnitte beginnen mit ein paar Sekunden Kontext, die du eventuell schon gehört hast.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelne Abschnitte beginnen mit ein paar Sekunden Kontext, die du eventuell schon gehört hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some sections start with a few seconds of context you may have already heard."
          }
        }
      }
    },
    "Enthält %lld von ^[%lld Stelle](inflect: true).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält %1$lld von ^[%2$lld Stelle](inflect: true)."
