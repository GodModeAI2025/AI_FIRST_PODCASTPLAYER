{
  "sourceLanguage": "de",
  "strings": {
    "Alles Ungehörte": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Ungehörte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Unplayed"
          }
        }
      }
    },
    "Alles Ungehörte, auch aus angefangenen Folgen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Ungehörte, auch aus angefangenen Folgen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All unplayed audio, including the rest of episodes you've started"
