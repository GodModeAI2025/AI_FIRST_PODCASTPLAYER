<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- `app-store-connect` ist der Weg nach TestFlight. `development` und
         `ad-hoc` erzeugen zwar auch eine .ipa, aber App Store Connect nimmt
         sie nicht an. -->
    <key>method</key><string>app-store-connect</string>
    <key>destination</key><string>upload</string>
    <key>teamID</key><string>$(PODCASTAI_TEAM_ID)</string>
    <key>signingStyle</key><string>automatic</string>
    <!-- Symbole mitschicken: ohne sie sind Abstuerze in TestFlight
         unlesbare Adressen statt Funktionsnamen. -->
    <key>uploadSymbols</key><true/>
    <!-- Bitcode ist seit Xcode 14 abgeschafft; die Angabe steht hier
         ausdruecklich auf false statt zu fehlen. -->
    <key>compileBitcode</key><false/>
    <key>manageAppVersionAndBuildNumber</key><false/>
</dict>
</plist>
