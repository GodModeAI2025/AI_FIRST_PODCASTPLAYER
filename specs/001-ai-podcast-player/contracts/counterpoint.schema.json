{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/counterpoint.schema.json",
  "title": "counterpoint",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "targetStanceID": {
      "type": "string",
      "minLength": 1
    },
    "targetStanceRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scopeID": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "counterpoint",
        "neutralComparison"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "proposed",
        "reviewed",
        "noEvidence",
        "stale"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "contradicts",
              "qualifies",
              "differentAssumptions",
              "complements"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "proposed",
              "userReviewed"
            ]
          }
        },
        "required": [
          "id",
          "evidenceIDs",
          "relation",
          "explanation",
          "reviewStatus"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "planID": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "targetStanceID",
    "targetStanceRevision",
    "scopeID",
    "mode",
    "state",
    "relations"
  ],
  "additionalProperties": false
}
