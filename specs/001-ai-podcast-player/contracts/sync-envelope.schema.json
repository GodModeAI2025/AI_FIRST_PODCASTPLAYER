{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/sync-envelope.schema.json",
  "title": "sync-envelope",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordID": {
      "type": "string",
      "minLength": 1
    },
    "entityKind": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "originDeviceID": {
      "type": "string",
      "minLength": 1
    },
    "logicalCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tombstone": {
      "type": "boolean"
    },
    "profileEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "recordID",
    "entityKind",
    "revision",
    "originDeviceID",
    "logicalCounter",
    "tombstone"
  ],
  "additionalProperties": false
}
