{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/archive-snapshot.schema.json",
  "title": "archive-snapshot",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceID": {
      "type": "string",
      "minLength": 1
    },
    "enumerator": {
      "type": "string",
      "enum": [
        "youtubeUploads",
        "publisherFeed",
        "storedHistory"
      ]
    },
    "selectedMode": {
      "type": "string",
      "enum": [
        "latestN",
        "dateRange",
        "manual",
        "allAvailable"
      ]
    },
    "observedAt": {
      "type": "string",
      "minLength": 1
    },
    "catalogState": {
      "type": "string",
      "enum": [
        "discovering",
        "partial",
        "complete",
        "blocked"
      ]
    },
    "analysisState": {
      "type": "string",
      "enum": [
        "queued",
        "active",
        "paused",
        "partial",
        "complete",
        "blocked"
      ]
    },
    "selectedEpisodeIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "discoveredCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "analyzableCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "analyzedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unavailableCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy": {
      "type": "object",
      "properties": {
        "autoAnalyzeNew": {
          "type": "boolean"
        },
        "analyzeHistory": {
          "type": "boolean"
        },
        "retainAudio": {
          "type": "boolean"
        },
        "network": {
          "type": "string",
          "enum": [
            "wifi",
            "any"
          ]
        }
      },
      "required": [
        "autoAnalyzeNew",
        "analyzeHistory",
        "retainAudio",
        "network"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sourceID",
    "enumerator",
    "selectedMode",
    "observedAt",
    "catalogState",
    "analysisState",
    "selectedEpisodeIDs",
    "discoveredCount",
    "analyzableCount",
    "analyzedCount",
    "unavailableCount",
    "nextCursor",
    "policy"
  ],
  "additionalProperties": false
}
