{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/playback-grant.schema.json",
  "title": "playback-grant",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "deviceID": {
      "type": "string",
      "minLength": 1
    },
    "sessionID": {
      "type": "string",
      "minLength": 1
    },
    "planHash": {
      "type": "string",
      "minLength": 1
    },
    "consentRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issuedAtEpochMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtEpochMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "explicitUI",
        "explicitChat",
        "explicitIntent"
      ]
    },
    "consumed": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "deviceID",
    "sessionID",
    "planHash",
    "consentRevision",
    "issuedAtEpochMs",
    "expiresAtEpochMs",
    "kind",
    "consumed"
  ],
  "additionalProperties": false
}
