{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/export-request.schema.json",
  "title": "export-request",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scopeID": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "enum": [
        "markdown",
        "srt",
        "vtt",
        "txt",
        "json"
      ]
    },
    "includeUserNotes": {
      "type": "boolean"
    },
    "includeOriginalExcerpts": {
      "type": "boolean"
    },
    "includePrivateLocators": {
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "scopeID",
    "format",
    "includeUserNotes",
    "includeOriginalExcerpts",
    "includePrivateLocators"
  ],
  "additionalProperties": false
}
