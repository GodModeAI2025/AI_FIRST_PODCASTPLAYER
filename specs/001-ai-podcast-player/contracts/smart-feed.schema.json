{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/smart-feed.schema.json",
  "title": "smart-feed",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topicIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "sourceEpisodeIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "profileRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policyRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "learningEnabled": {
      "type": "boolean"
    },
    "unheardFilter": {
      "type": "string",
      "enum": [
        "unheardSegments",
        "neverStartedEpisodes"
      ]
    },
    "editionMode": {
      "type": "string",
      "enum": [
        "allUnheard",
        "budgeted"
      ]
    },
    "activeListeningBudgetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "publicationPolicy": {
      "type": "string",
      "enum": [
        "whenNewSegments",
        "manual"
      ]
    },
    "notificationsEnabled": {
      "type": "boolean"
    },
    "privacy": {
      "const": "privateInApp"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "topicIDs",
    "sourceEpisodeIDs",
    "profileRevision",
    "policyRevision",
    "learningEnabled",
    "unheardFilter",
    "editionMode",
    "activeListeningBudgetMs",
    "publicationPolicy",
    "notificationsEnabled",
    "privacy"
  ],
  "additionalProperties": false
}
