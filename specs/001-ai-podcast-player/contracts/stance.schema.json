{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/stance.schema.json",
  "title": "stance",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "confirmed",
        "rejected",
        "withdrawn"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "explicitUser",
        "modelSuggestion"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "ordinary",
        "sensitive",
        "political"
      ]
    },
    "sourceSignalIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "profileEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "text",
    "status",
    "origin",
    "sensitivity",
    "sourceSignalIDs",
    "profileEpoch"
  ],
  "additionalProperties": false
}
