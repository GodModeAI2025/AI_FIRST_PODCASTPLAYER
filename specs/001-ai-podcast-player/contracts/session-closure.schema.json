{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/session-closure.schema.json",
  "title": "session-closure",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sessionID": {
      "type": "string",
      "minLength": 1
    },
    "parentSessionID": {
      "type": [
        "string",
        "null"
      ]
    },
    "closingRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "closing",
        "closed"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "naturalEnd",
        "budgetEnd",
        "explicitEnd",
        "interrupted",
        "sleepTimer"
      ]
    },
    "choice": {
      "type": "string",
      "enum": [
        "unanswered",
        "deepen",
        "park",
        "discard"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "sourceEvidenceIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "uniqueSourceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "followUpState": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "noEvidence"
      ]
    },
    "graphID": {
      "type": "string",
      "minLength": 1
    },
    "exportState": {
      "type": "string",
      "enum": [
        "notRequested",
        "pending",
        "exported",
        "failed"
      ]
    },
    "startNextAutomatically": {
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sessionID",
    "parentSessionID",
    "closingRevision",
    "state",
    "reason",
    "choice",
    "question",
    "sourceEvidenceIDs",
    "uniqueSourceCount",
    "followUpState",
    "graphID",
    "exportState",
    "startNextAutomatically"
  ],
  "additionalProperties": false
}
