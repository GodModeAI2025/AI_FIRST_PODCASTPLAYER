{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/analysis-job.schema.json",
  "title": "analysis-job",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mediaVersionID": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "string",
      "enum": [
        "acquire",
        "transcribe",
        "align",
        "chapters",
        "claims",
        "index",
        "relevance"
      ]
    },
    "inputDigest": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting",
        "paused",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "checkpointOrdinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retryCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "waitReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "mediaVersionID",
    "step",
    "inputDigest",
    "version",
    "state",
    "checkpointOrdinal",
    "retryCount",
    "waitReason"
  ],
  "additionalProperties": false
}
