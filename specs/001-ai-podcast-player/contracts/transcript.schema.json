{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/transcript.schema.json",
  "title": "transcript",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mediaVersionID": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "timingStatus": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "none"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "publisher",
        "appleSpeech",
        "userImport"
      ]
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          },
          "speakerLabel": {
            "type": "string",
            "minLength": 1
          },
          "final": {
            "type": "boolean"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "range": {
                  "type": "object",
                  "properties": {
                    "startMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "startMs",
                    "endMs"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "text",
                "range"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "text",
          "final"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "locale",
    "timingStatus",
    "origin",
    "segments"
  ],
  "additionalProperties": false
}
