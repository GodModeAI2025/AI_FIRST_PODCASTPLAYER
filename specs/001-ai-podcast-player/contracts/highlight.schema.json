{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/highlight.schema.json",
  "title": "highlight",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "evidenceIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "originalExcerpt": {
      "type": "string",
      "minLength": 1
    },
    "userNote": {
      "type": "string"
    },
    "generatedSummary": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "string",
      "enum": [
        "player",
        "transcript",
        "watch",
        "intent"
      ]
    },
    "timingStatus": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "none"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "evidenceIDs",
    "originalExcerpt",
    "userNote",
    "generatedSummary",
    "tags",
    "revision",
    "origin",
    "timingStatus"
  ],
  "additionalProperties": false
}
