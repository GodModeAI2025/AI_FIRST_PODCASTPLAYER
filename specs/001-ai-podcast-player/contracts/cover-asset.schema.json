{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/cover-asset.schema.json",
  "title": "cover-asset",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "string",
      "enum": [
        "nativeTemplate",
        "userConfirmedImagePlayground",
        "userSelectedImage",
        "reusedFeedArtwork"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "templateReady",
        "awaitingUserAction",
        "persisted"
      ]
    },
    "userConfirmed": {
      "type": "boolean"
    },
    "provider": {
      "type": "string",
      "enum": [
        "none",
        "apple"
      ]
    },
    "externalProvider": {
      "const": false
    },
    "templateID": {
      "type": "string",
      "minLength": 1
    },
    "altText": {
      "type": "string",
      "minLength": 1
    },
    "syntheticFixture": {
      "type": "boolean"
    },
    "assetRelativePath": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "origin",
    "state",
    "userConfirmed",
    "provider",
    "externalProvider",
    "altText"
  ],
  "additionalProperties": false
}
