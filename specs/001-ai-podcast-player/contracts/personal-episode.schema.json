{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/personal-episode.schema.json",
  "title": "personal-episode",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "feedID": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policyRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "batchKey": {
      "type": "string",
      "minLength": 1
    },
    "manifestHash": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "minLength": 1
    },
    "publicationState": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "unavailable",
        "archived"
      ]
    },
    "consumptionState": {
      "type": "string",
      "enum": [
        "unplayed",
        "inProgress",
        "completed"
      ]
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "episodeID": {
            "type": "string",
            "minLength": 1
          },
          "mediaVersionID": {
            "type": "string",
            "minLength": 1
          },
          "transcriptRevisionID": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "coreRange": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          },
          "playbackRange": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "virtualRange": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          },
          "topicIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "contextReplay": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "episodeID",
          "mediaVersionID",
          "transcriptRevisionID",
          "evidenceIDs",
          "coreRange",
          "playbackRange",
          "reason",
          "virtualRange",
          "topicIDs",
          "contextReplay"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "shownotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "text",
          "evidenceIDs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "coverAssetID": {
      "type": "string",
      "minLength": 1
    },
    "totalMediaMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "coverage": {
      "type": "object",
      "properties": {
        "discoveredEpisodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "analyzedEpisodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "includedEpisodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remainingMatchedSegments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completeWithinAnalyzedScope": {
          "type": "boolean"
        }
      },
      "required": [
        "discoveredEpisodes",
        "analyzedEpisodes",
        "includedEpisodes",
        "remainingMatchedSegments",
        "completeWithinAnalyzedScope"
      ],
      "additionalProperties": false
    },
    "audioPolicy": {
      "const": "originalOnly"
    },
    "syntheticFixture": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "feedID",
    "revision",
    "policyRevision",
    "batchKey",
    "manifestHash",
    "title",
    "publishedAt",
    "publicationState",
    "consumptionState",
    "segments",
    "shownotes",
    "coverAssetID",
    "totalMediaMs",
    "coverage",
    "audioPolicy"
  ],
  "additionalProperties": false
}
