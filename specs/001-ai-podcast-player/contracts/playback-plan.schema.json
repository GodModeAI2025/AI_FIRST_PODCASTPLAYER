{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/playback-plan.schema.json",
  "title": "playback-plan",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scopeDigest": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "episodeID": {
            "type": "string",
            "minLength": 1
          },
          "mediaVersionID": {
            "type": "string",
            "minLength": 1
          },
          "transcriptRevisionID": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "coreRange": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          },
          "playbackRange": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "episodeID",
          "mediaVersionID",
          "transcriptRevisionID",
          "evidenceIDs",
          "coreRange",
          "playbackRange",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "activeListeningBudgetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "playbackRate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 4
    },
    "transitionMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "estimatedListeningMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "planHash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "scopeDigest",
    "segments",
    "activeListeningBudgetMs",
    "playbackRate",
    "transitionMs",
    "estimatedListeningMs",
    "planHash"
  ],
  "additionalProperties": false
}
