{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/brainspeak/agent-share-grant.schema.json",
  "title": "agent-share-grant",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "clientBinding": {
      "type": "string",
      "minLength": 1
    },
    "allowedSourceIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revoked": {
      "type": "boolean"
    },
    "disclosureAccepted": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "clientBinding",
    "allowedSourceIDs",
    "allowedTools",
    "revision",
    "revoked",
    "disclosureAccepted"
  ],
  "additionalProperties": false
}
